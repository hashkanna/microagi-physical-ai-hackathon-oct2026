# Copy to .env and fill in. Credentials stay server-side; the browser never sees them.

# Required only for real video -> scene extraction and LLM-parsed corrections.
# Without it, CellCheck runs in clearly labelled fixture/sample mode.
OPENAI_API_KEY=

# Vision model used for scene extraction (any vision-capable model with structured outputs).
OPENAI_VISION_MODEL=gpt-6.1-sol

# Headless rendering backend: egl (default) or osmesa (pure software fallback).
MUJOCO_GL=egl

# Where projects, runs and evidence are stored (gitignored).
# CELLCHECK_DATA=./data

PORT=8000
